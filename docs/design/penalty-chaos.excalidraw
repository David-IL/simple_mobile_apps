      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The whole game is here:\n• banner shows the gag BEFORE the run-up\n• keeper commits, then leans (the tell)\n• drag up from anywhere, release to shoot\n• zone grid is drawn so the read is learnable",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The whole game is here:\n• banner shows the gag BEFORE the run-up\n• keeper commits, then leans (the tell)\n• drag up from anywhere, release to shoot\n• zone grid is drawn so the read is learnable",
      "autoResize": true,
      "lineHeight": 1.25
